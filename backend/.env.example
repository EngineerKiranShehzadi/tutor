# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/askaitutor
DB_HOST=localhost
DB_PORT=5432
DB_NAME=askaitutor
DB_USER=postgres
DB_PASSWORD=postgres

# ─────────────────────────────────────────────
# JWT
# Generate unique secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# EMAIL — Gmail SMTP via Nodemailer
#
# HOW TO GET YOUR APP PASSWORD:
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" (required)
#   3. Search for "App passwords" in the search bar
#   4. Create a new App Password:
#        App  → Mail
#        Device → Other → type "AskAITutor"
#   5. Google gives you a 16-character password
#      e.g.  abcd efgh ijkl mnop
#   6. Copy it WITHOUT spaces → paste below as EMAIL_PASSWORD
#
# NOTE: This is NOT your Gmail login password.
#       It is a special app-specific password.
#
# Leave EMAIL_USER and EMAIL_PASSWORD empty to skip email in development.
# The server will log OTP codes to the console instead.
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your16charapppasswordnospaces
EMAIL_FROM_NAME=AskAITutor

# ─────────────────────────────────────────────
# PASSWORD RESET
# ─────────────────────────────────────────────
RESET_TOKEN_EXPIRES_MS=3600000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────
# BCRYPT
# ─────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─────────────────────────────────────────────
# OBSERVABILITY / PHOENIX
#
# Fully optional — the tutoring request path never depends on any of this.
# When OBSERVABILITY_ENABLED or PHOENIX_ENABLED is false/unset, no tracing
# work beyond building an in-memory trace object happens, and the Phoenix
# OTel SDK is never even initialized.
# ─────────────────────────────────────────────
OBSERVABILITY_ENABLED=false
OBSERVABILITY_SAMPLE_RATE=1
# Capture truncated question/answer/prompt/chunk-text previews on spans and
# in the admin trace detail UI. When false, only metadata (lengths, hashes,
# ids, counts, scores) is ever captured — no raw content.
OBSERVABILITY_CAPTURE_CONTENT=false
OBSERVABILITY_MAX_CONTENT_LENGTH=20000

PHOENIX_ENABLED=false
# OTLP trace-ingestion endpoint (export path) — distinct from PHOENIX_BASE_URL below.
PHOENIX_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# Back-compat alias some existing tooling/scripts read — keep in sync with
# PHOENIX_OTLP_ENDPOINT above; either name works.
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# Root URL of the Phoenix server itself (read-back / admin UI API calls) —
# NOT the OTLP ingest path above.
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_PROJECT_NAME=askaitutor
# Optional bearer token for a Phoenix instance that requires auth. Never
# sent to the frontend — stays server-side only.
PHOENIX_API_KEY=
PHOENIX_QUERY_TIMEOUT_MS=10000
PHOENIX_OVERVIEW_CACHE_TTL_MS=15000

