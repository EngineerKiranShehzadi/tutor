# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Maximum time (ms) a graceful shutdown (SIGTERM/SIGINT) may take: finish
# in-flight requests, flush pending traces to Phoenix, close the DB pool.
# If it takes longer, the process is force-exited with code 1.
SHUTDOWN_TIMEOUT_MS=10000
# Production only: also write logs/error.log and logs/combined.log (rotated at
# 10 MB, 5 files kept). Default false = console-only JSON logs (each line
# carries "traceId" when logged inside a request trace).
LOG_TO_FILE=false

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/askaitutor
DB_HOST=localhost
DB_PORT=5432
DB_NAME=askaitutor
DB_USER=postgres
DB_PASSWORD=postgres

# ─────────────────────────────────────────────
# AWS S3 — raw dataset archival
#
# Every uploaded .xlsx dataset is stored here exactly as received, before
# chunk.service.ts parses/chunks/embeds it — see services/s3-storage.
# service.ts. Not required to boot the app; only the dataset-upload
# endpoint needs it, and fails with a clear error if it's missing.
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are optional — leave them unset
# to use the default AWS credential provider chain (e.g. an IAM role)
# instead of static keys.
# ─────────────────────────────────────────────
S3_DATASET_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────
# JWT
# Generate unique secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# EMAIL — Gmail SMTP via Nodemailer
#
# HOW TO GET YOUR APP PASSWORD:
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" (required)
#   3. Search for "App passwords" in the search bar
#   4. Create a new App Password:
#        App  → Mail
#        Device → Other → type "AskAITutor"
#   5. Google gives you a 16-character password
#      e.g.  abcd efgh ijkl mnop
#   6. Copy it WITHOUT spaces → paste below as EMAIL_PASSWORD
#
# NOTE: This is NOT your Gmail login password.
#       It is a special app-specific password.
#
# Leave EMAIL_USER and EMAIL_PASSWORD empty to skip email in development.
# The server will log OTP codes to the console instead.
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your16charapppasswordnospaces
EMAIL_FROM_NAME=AskAITutor

# ─────────────────────────────────────────────
# PASSWORD RESET
# ─────────────────────────────────────────────
RESET_TOKEN_EXPIRES_MS=3600000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────
# BCRYPT
# ─────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─────────────────────────────────────────────
# OBSERVABILITY / PHOENIX
#
# Fully optional — the tutoring request path never depends on any of this.
# When OBSERVABILITY_ENABLED or PHOENIX_ENABLED is false/unset, no tracing
# work beyond building an in-memory trace object happens, and the Phoenix
# OTel SDK is never even initialized.
# ─────────────────────────────────────────────
OBSERVABILITY_ENABLED=false
# Fraction (0-1) of ordinary, fast, answered traces exported to Phoenix.
# Errors, non-answered responses, verifier failures and slow traces are
# ALWAYS exported regardless. rag_request_log gets a row for every request.
OBSERVABILITY_SAMPLE_RATE=1
# A trace slower than this (ms) counts as "interesting" and is always exported.
OBSERVABILITY_SLOW_TRACE_MS=10000
# Capture truncated question/answer/prompt/chunk-text previews on spans and
# in the admin trace detail UI. When false, only metadata (lengths, hashes,
# ids, counts, scores) is ever captured — no raw content.
OBSERVABILITY_CAPTURE_CONTENT=false
OBSERVABILITY_MAX_CONTENT_LENGTH=20000

# Email alerts + nightly cleanup (observability/alerts.service.ts, maintenance.scheduler.ts).
# Rules run over the last ALERT_WINDOW_MINUTES of rag_request_log and need at
# least ALERT_MIN_REQUESTS rows (except llm_rate_limited). Rates are 0..1.
# Opt-in: off unless explicitly set. Set true in production.
OBSERVABILITY_ALERTS_ENABLED=false
ALERT_CHECK_INTERVAL_MS=300000
ALERT_WINDOW_MINUTES=15
ALERT_MIN_REQUESTS=20
ALERT_ERROR_RATE=0.05
ALERT_NOT_FOUND_RATE=0.40
ALERT_P95_MS=15000
ALERT_COOLDOWN_MINUTES=60
# Comma-separated recipients; empty = every user with role ADMIN.
ALERT_EMAILS=
# rag_request_log rows older than this are deleted once every 24 h.
OBSERVABILITY_RETENTION_DAYS=90

PHOENIX_ENABLED=false
# OTLP trace-ingestion endpoint (export path) — distinct from PHOENIX_BASE_URL below.
PHOENIX_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# Back-compat alias some existing tooling/scripts read — keep in sync with
# PHOENIX_OTLP_ENDPOINT above; either name works.
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# Root URL of the Phoenix server itself (read-back / admin UI API calls) —
# NOT the OTLP ingest path above.
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_PROJECT_NAME=askaitutor-rag
# Phoenix URL an admin opens in their browser (may differ from
# PHOENIX_BASE_URL, which is backend-to-Phoenix). Used to add a
# phoenixTraceUrl link to each /monitor/attention row. Empty = feature off.
PHOENIX_PUBLIC_URL=
# Optional bearer token for a Phoenix instance that requires auth. Never
# sent to the frontend — stays server-side only.
PHOENIX_API_KEY=
PHOENIX_QUERY_TIMEOUT_MS=10000
PHOENIX_OVERVIEW_CACHE_TTL_MS=15000

# Write one rag_request_log row per request (metadata only, no question/answer
# text). A failed write logs a warning and never affects the student's answer.
REQUEST_LOG_ENABLED=true
# Per-model USD prices (per 1M tokens). rag_request_log.est_cost_usd and the
# Monitor cost figures are computed from this map; models not listed -> NULL
# cost. Take the numbers from the provider's pricing page.
LLM_PRICING_JSON={"gemini-3.8-flash":{"inputPer1M":0.75,"outputPer1M":3.75},"gemini-2.5-flash-lite":{"inputPer1M":0.10,"outputPer1M":0.40}}

# ─────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
#
# Every LLM-dependent service picks its provider + model independently —
# see src/llm/llm-provider.resolver.ts. Only "gemini" has a real adapter
# today (src/llm/providers/gemini-llm.provider.ts); setting any *_PROVIDER
# below to something else fails fast with a clear error at call time.
# ─────────────────────────────────────────────
#
# Final model choice (uncomment to use): answer generation + answer
# verification on Gemini 3.8 Flash, every other task on Gemini 2.5 Flash-Lite.
#   RAG_ANSWER_MODEL=gemini-3.8-flash
#   ANSWER_VERIFICATION_LLM_MODEL=gemini-3.8-flash
#   QUERY_ROUTER_LLM_MODEL=gemini-2.5-flash-lite
#   QUERY_REWRITE_LLM_MODEL=gemini-2.5-flash-lite
#   GUARDRAIL_LLM_MODEL=gemini-2.5-flash-lite
#   QUERY_DECOMPOSITION_LLM_MODEL=gemini-2.5-flash-lite
#   ADAPTIVE_RETRIEVAL_LLM_MODEL=gemini-2.5-flash-lite
#   OUTPUT_FORMAT_REPAIR_LLM_MODEL=gemini-2.5-flash-lite
#   GREETING_LLM_MODEL=gemini-2.5-flash-lite
#   LECTURE_SUMMARY_LLM_MODEL=gemini-2.5-flash-lite
#
# Per-task thinking effort: off | minimal | low | medium | high. One setting
# works for any model — 2.5 models get a thinkingBudget, 3.x models a
# thinkingLevel (see src/llm/providers/gemini-thinking.ts). Gemini 3.8 Flash
# cannot go below LOW (MINIMAL is rejected), so off/minimal become LOW there.
# Thinking tokens count against each call's max output tokens.
RAG_ANSWER_THINKING=low
ANSWER_VERIFICATION_THINKING=off
QUERY_ROUTER_THINKING=minimal
QUERY_REWRITE_THINKING=minimal
GUARDRAIL_THINKING=minimal
QUERY_DECOMPOSITION_THINKING=minimal
ADAPTIVE_RETRIEVAL_THINKING=minimal
OUTPUT_FORMAT_REPAIR_THINKING=minimal
GREETING_THINKING=minimal
LECTURE_SUMMARY_THINKING=low

# Retrieval backends. Only `local-http` (the Python server at
# EMBEDDING_SERVER_URL / RERANK_SERVER_URL) exists today. Changing the embedding
# provider changes EMBEDDING_MODEL_VERSION — re-embed before switching.
EMBEDDING_PROVIDER=local-http
RERANK_PROVIDER=local-http
# Minimum cosine similarity a chunk needs to survive vector search.
VECTOR_SIMILARITY_THRESHOLD=0.55
# Minimum reranker score a chunk needs to be used as context.
RERANK_MIN_SCORE=0.5

# Output cap for the groundedness verifier. Thinking tokens count against it and
# Gemini 3.x cannot turn thinking off, so raise this (e.g. 1500) on those models.
ANSWER_VERIFICATION_MAX_OUTPUT_TOKENS=500

# Prior chat turns passed to the router/rewriter/answer prompt as context
# (0 = no history).
CHAT_HISTORY_TURNS=10

RAG_LLM_PROVIDER=gemini
RAG_ANSWER_MODEL=gemini-2.5-flash
# Used once an answer-generation retry exceeds llm-gemini.service.ts's own
# attempt<=2 threshold — a same-provider fallback model, not a different
# provider.
RAG_ANSWER_FALLBACK_MODEL=gemini-flash-latest

QUERY_ROUTER_LLM_PROVIDER=gemini
QUERY_ROUTER_LLM_MODEL=gemini-2.5-flash

# Natural replies to greetings / small talk (falls back to a fixed message on failure)
GREETING_LLM_PROVIDER=gemini
GREETING_LLM_MODEL=gemini-2.5-flash
GREETING_LLM_TIMEOUT_MS=6000
GREETING_LLM_TEMPERATURE=0.7

QUERY_REWRITE_LLM_PROVIDER=gemini
QUERY_REWRITE_LLM_MODEL=gemini-2.5-flash

LECTURE_SUMMARY_LLM_PROVIDER=gemini
LECTURE_SUMMARY_LLM_MODEL=gemini-2.5-flash

# Used by the prompt-injection semantic classifier (Stage B) — see
# src/rag/guardrails/input/classifiers/prompt-injection-classifier.service.ts.
# GUARDRAIL_LLM_ENABLED only gates that classifier; it does not disable the
# rest of the input guardrail (deterministic checks keep running either way).
GUARDRAIL_LLM_ENABLED=true
GUARDRAIL_LLM_PROVIDER=gemini
GUARDRAIL_LLM_MODEL=gemini-2.5-flash
GUARDRAIL_LLM_TIMEOUT_MS=4000
GUARDRAIL_LLM_TEMPERATURE=0

# Used by the single DIRECT/DECOMPOSE structured-output call — see
# src/rag/query-processing/decomposition/subquery-decomposition.service.ts.
# Only reached for candidate compound queries (a cheap deterministic gate in
# compound-query.detector.ts runs first); an ordinary question never calls
# this.
QUERY_DECOMPOSITION_LLM_PROVIDER=gemini
QUERY_DECOMPOSITION_LLM_MODEL=gemini-2.5-flash
QUERY_DECOMPOSITION_LLM_TIMEOUT_MS=4000
QUERY_DECOMPOSITION_LLM_TEMPERATURE=0

# Used by the STOP/RETRIEVE planner — see src/rag/query-processing/
# adaptive-retrieval/adaptive-retrieval-planner.service.ts. Only reached
# when decomposition's own deterministic coverage signal already found an
# uncovered aspect; never called for a fully-covered or non-decomposed
# query.
ADAPTIVE_RETRIEVAL_LLM_PROVIDER=gemini
ADAPTIVE_RETRIEVAL_LLM_MODEL=gemini-2.5-flash
ADAPTIVE_RETRIEVAL_LLM_TIMEOUT_MS=4000
ADAPTIVE_RETRIEVAL_LLM_TEMPERATURE=0

# Used by both the groundedness verifier and the bounded revision rewrite —
# see src/rag/guardrails/output/. Deliberately independent of
# RAG_ANSWER_MODEL (the generator) so verification/correction can use a
# different model without touching generation config.
ANSWER_VERIFICATION_LLM_PROVIDER=gemini
ANSWER_VERIFICATION_LLM_MODEL=gemini-2.5-flash
ANSWER_VERIFICATION_LLM_TIMEOUT_MS=4000
ANSWER_VERIFICATION_LLM_TEMPERATURE=0

# Used only when Selective Output Format Validation finds a grounded answer
# that doesn't structurally match an explicitly requested LIST/TABLE — see
# src/rag/guardrails/output/format/response-format-repair.service.ts. Most
# LIST cases never reach this call (a cheap deterministic repair handles the
# common case first). Deliberately independent of RAG_ANSWER_MODEL/
# ANSWER_VERIFICATION_LLM_MODEL — this only ever reformats, never
# regenerates or re-judges content.
OUTPUT_FORMAT_REPAIR_LLM_PROVIDER=gemini
OUTPUT_FORMAT_REPAIR_LLM_MODEL=gemini-2.5-flash
OUTPUT_FORMAT_REPAIR_LLM_TIMEOUT_MS=4000
OUTPUT_FORMAT_REPAIR_LLM_TEMPERATURE=0

# ─────────────────────────────────────────────
# INPUT GUARDRAIL (pre-query)
#
# Runs before query-router.service.ts on every chat question — see
# src/rag/guardrails/input/input-guardrail.service.ts. MAX_CHARS/MAX_TOKENS
# are application-level limits, deliberately independent of whatever
# context window the configured model actually supports.
# ─────────────────────────────────────────────
INPUT_GUARDRAIL_ENABLED=true
INPUT_GUARDRAIL_MAX_CHARS=8000
INPUT_GUARDRAIL_MAX_TOKENS=2000
INPUT_GUARDRAIL_PII_ENABLED=true
INPUT_GUARDRAIL_INJECTION_ENABLED=true
INPUT_GUARDRAIL_MALICIOUS_PAYLOAD_ENABLED=true

# ─────────────────────────────────────────────
# SELECTIVE SUBQUERY DECOMPOSITION
#
# Runs after routing/history-rewriting, on the effective self-contained
# query — see src/rag/query-processing/decomposition/subquery-
# decomposition.service.ts. Distinct from the history-based query rewriter:
# that resolves references from prior conversation, this splits a
# self-contained but genuinely multi-intent query into independent
# retrieval needs. Most questions never trigger an LLM call at all — see
# compound-query.detector.ts's cheap deterministic gate.
# ─────────────────────────────────────────────
QUERY_DECOMPOSITION_ENABLED=true
# Hard cap on fan-out — kept small on purpose.
QUERY_DECOMPOSITION_MAX_SUBQUERIES=3

# ─────────────────────────────────────────────
# ITERATIVE ADAPTIVE RETRIEVAL
#
# Runs only when Selective Subquery Decomposition's existing coverage
# signal already found a real evidence gap (one or more uncovered
# subqueries) — see src/rag/query-processing/adaptive-retrieval/
# adaptive-retrieval.service.ts. Not Similar Query Generation: each
# iteration produces exactly one targeted retrieval query for a specific
# missing aspect, never paraphrases of the whole question.
# ─────────────────────────────────────────────
ADAPTIVE_RETRIEVAL_ENABLED=true
# Each iteration is at most one new targeted retrieval query. Keep this at
# 1 unless you've evaluated the latency/quality tradeoff of going higher.
ADAPTIVE_RETRIEVAL_MAX_ITERATIONS=1

# ─────────────────────────────────────────────
# ANSWER VERIFICATION (post-generation output guardrail)
#
# Runs after the existing strict grounded generator produces a draft — see
# src/rag/guardrails/output/output-guardrail.service.ts. Judges the draft
# against the exact evidence chunks generation actually used; this is NOT
# another retrieval pass (Iterative Adaptive Retrieval already owns
# pre-generation evidence gaps). Only reached for LLM-generated grounded
# answers — never for GREETING's canned reply or a deterministic
# not-found fallback.
# ─────────────────────────────────────────────
ANSWER_VERIFICATION_ENABLED=true
# At most one bounded revise-then-reverify pass — never an open-ended
# generate/verify/revise loop. Keep this at 1 unless you've evaluated the
# latency/quality tradeoff of going higher.
ANSWER_VERIFICATION_MAX_REVISIONS=1

# ─────────────────────────────────────────────
# SELECTIVE OUTPUT FORMAT VALIDATION (post-generation output guardrail)
#
# Runs after groundedness verification/revision, only when the effective
# user query explicitly asked for a LIST or TABLE — see src/rag/guardrails/
# output/format/. Most questions stay NATURAL_TEXT and never reach
# validation/repair. Independent of ANSWER_VERIFICATION_ENABLED.
# ─────────────────────────────────────────────
OUTPUT_FORMAT_VALIDATION_ENABLED=true
# One bounded repair attempt only — never an iterative repair loop.
OUTPUT_FORMAT_REPAIR_ENABLED=true

# ─────────────────────────────────────────────
# OUTPUT PII LEAKAGE DETECTION (post-generation output guardrail)
#
# Runs after groundedness verification/revision and after any format
# repair, on the actual final answer text — see src/rag/guardrails/output/
# pii/output-pii-leakage.guard.ts. Shares detection/sanitization rules with
# the input PII guard via src/rag/guardrails/shared/pii/.
# ─────────────────────────────────────────────
OUTPUT_PII_GUARD_ENABLED=true

