# ─────────────────────────────────────────────
# EMAIL — Gmail SMTP via Nodemailer
#
# HOW TO GET YOUR APP PASSWORD:
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" (required)
#   3. Search for "App passwords" in the search bar
#   4. Create a new App Password:
#        App  → Mail
#        Device → Other → type "AskAITutor"
#   5. Google gives you a 16-character password
#      e.g.  abcd efgh ijkl mnop
#   6. Copy it WITHOUT spaces → paste below as EMAIL_PASSWORD
#
# NOTE: This is NOT your Gmail login password.
#       It is a special app-specific password.
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=kiranshehzadiroshni@gmail.com
EMAIL_PASSWORD=bbrw dxqt ijvo qjut
EMAIL_FROM_NAME=AskAITutor

# ─────────────────────────────────────────────
# PASSWORD RESET
# ─────────────────────────────────────────────
RESET_TOKEN_EXPIRES_MS=3600000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
