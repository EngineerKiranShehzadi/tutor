# Disable npm's background "new version available" check.
#
# It performs an async network fetch (registry.npmjs.org) on every `npm`
# CLI invocation (including `npm run`/`npm test`). In this environment that
# request sometimes comes back with a non-JSON body, which npm's own
# internals don't catch — the resulting unhandled promise rejection crashes
# the whole npm process with exit code 1 and no readable error, independent
# of whatever command was actually running. See the flaky `npm test`
# root-cause note in test-observability.ts for the full diagnosis.
update-notifier=false
