node_modules
evidence/
backend/tune-out/

# ── Secrets — never commit ────────────────────────────────────────────────────
# backend/.env holds the OpenAI and Voyage API keys, the Neon database
# password, both JWT secrets and the email password. frontend/.env.local holds
# the API URL. None of these belong in a repository: once pushed they stay in
# the history even after being deleted, and the keys would have to be rotated.
#
# Only the .example templates, which carry placeholder values, are tracked.
# A pattern without a slash matches at every level, so these cover
# backend/.env, frontend/.env.local and any future one.
.env
.env.*
!.env.example
!.env.local.example
!.env.*.example

# ── Build output ──────────────────────────────────────────────────────────────
# Regenerated by `npm run build`; committing it adds thousands of files and
# conflicts on every merge.
.next/
dist/
*.tsbuildinfo

# ── Local noise ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
npm-debug.log*
