# Copy to .env (git-ignored) in this directory. Read by docker-compose.yml. Placeholder values below (CHANGE_ME) are NOT real; replace them all.

# Connection string for a DEDICATED Phoenix database on Neon — a separate
# database (or project) used only by Phoenix. NEVER the app's DATABASE_URL.
# Use the DIRECT (non-pooler) host. Example shape:
#   postgresql://phoenix_user:PASSWORD@ep-xxxx.region.aws.neon.tech/phoenix?sslmode=require
PHOENIX_SQL_DATABASE_URL=postgresql://phoenix_user:CHANGE_ME@ep-xxxx.region.aws.neon.tech/phoenix?sslmode=require

# Long random string used to sign login tokens (JWTs). Generate with:
#   openssl rand -base64 48
# Changing it later logs everyone out.
PHOENIX_SECRET=CHANGE_ME_long_random_string

# Password for the built-in admin account (admin@localhost). Only applies on
# first start, while the password is still unchanged. Change it in the UI
# after first login anyway.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_password
